{
  "name": "dovoworld",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-19",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "send_email": [
    { "name": "EMAIL", "destination_address": "divyabharathi.renga@gmail.com" }
  ],
  "ai": { "binding": "AI" },
  "ratelimits": [
    { "name": "BLOG_DEMO_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } }
  ]
}
